# A reload that fails leaves the running VCL and its tenants alone

varnish v1 -errvcl {Group 'nope' missing for tenant: xpizza.com} {
vcl 4.1;
	import riscv;

	backend default none;

	sub vcl_init {
		riscv.embed_tenants("""{
			"xpizza.com": {
				"filename": "${tmpdir}/prog",
				"group": "nope"
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (req.url == "/update") {
			if (riscv.live_update_file("xpizza.com", "${tmpdir}/b")) {
				return (synth(200, "Updated"));
			}
			return (synth(500, "Update failed"));
		}
		if (!riscv.fork(req.http.Host)) {
			return (synth(403));
		}
		riscv.vcall(ON_REQUEST);
		if (riscv.want_result() == "synth") {
			return (synth(riscv.want_status()));
		}
		return (synth(400));
	}
	sub vcl_synth {
		if (riscv.active()) {
			riscv.vcall(ON_SYNTH);
			return (deliver);
		}
	}
}

client c1 {
	txreq -url "/" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.body == "Program B is a different size"
} -run

# Discard everything but the active VCL, freeing what only they held
varnish v1 -cliok "vcl.discard vcl2"
varnish v1 -cliok "vcl.discard vcl3"

client c1 {
	txreq -url "/" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.body == "Program B is a different size"
} -run

# A tenant removed from the configuration is gone, and a VCL can not
# reconfigure its tenants while it serves requests.

varnish v1 -vcl+backend {
vcl 4.1;
	import riscv;

	backend default none;

	sub vcl_init {
		riscv.embed_tenants("""{
			"other.com": {
				"filename": "${tmpdir}/a"
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (req.url == "/update") {
			if (riscv.live_update_file("xpizza.com", "${tmpdir}/b")) {
				return (synth(200, "Updated"));
			}
			return (synth(500, "Update failed"));
		}
		if (req.url == "/argv") {
			riscv.add_main_argument("other.com", "x");
			return (synth(200));
		}
		if (!riscv.fork(req.http.Host)) {
			return (synth(403));
		}
		riscv.vcall(ON_REQUEST);
		if (riscv.want_result() == "synth") {
			return (synth(riscv.want_status()));
		}
		return (synth(400));
	}
	sub vcl_synth {
		if (riscv.active()) {
			riscv.vcall(ON_SYNTH);
			return (deliver);
		}
	}
}

client c1 {
	txreq -url "/" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 403
} -run

client c1 {
	txreq -url "/" -hdr "Host: other.com"
	rxresp
	expect resp.status == 200
	expect resp.body == "Program A"
	txreq -url "/argv" -hdr "Host: other.com"
	rxresp
	expect resp.status == 503
} -run

logexpect l1 -v v1 -g raw -d 1 {
	expect * * VCL_Error "riscv.add_main_argument\\(\\) can only be used in vcl_init"
} -run
