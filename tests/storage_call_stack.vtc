varnishtest "RISC-V: storage calls keep their own stack, and leave the stack pointer as it was"

shell {
cat >${tmpdir}/${testname}.cpp <<-EOF
#include "riscv_api.hpp"

#define STR2(x) #x
#define STR(x) STR2(x)
asm(".globl storage_call\n"
    "storage_call:\n"
    "	li a7, " STR(ECALL_REMOTECALL) "\n"
    "	ecall\n"
    "	ret\n");
extern "C" long storage_call(long (*func)(long, long, long, long), long a, long b, long c, long d);
asm(".globl fast_exit\n"
    "fast_exit:\n"
    "	addi sp, sp, -16\n"
    "	sd ra, 8(sp)\n"
    "	.long 0x7ff00073\n");

#define BUFLEN 16384

static long storage_fn(long a, long, long, long)
{
	volatile char buf[BUFLEN];
	for (int i = 0; i < BUFLEN; i++)
		buf[i] = (char)0xA5;
	return a + buf[0] - (char)0xA5 + 1;
}

static long storage_sp(long, long, long, long)
{
	long sp;
	asm volatile ("mv %0, sp" : "=r"(sp));
	return sp;
}

static void on_recv(int req)
{
	char url[128];
	const long len = get_url(req, url, sizeof(url)-1);
	url[len < 0 ? 0 : len] = 0;
	if (strcmp(url, "/sp") == 0) {
		const long sp1 = storage_call(storage_sp, 0, 0, 0, 0);
		const long sp2 = storage_call(storage_sp, 0, 0, 0, 0);
		decision("synth", 5, sp1 == sp2 ? 200 : 500);
		return;
	}
	volatile char buf[BUFLEN];
	for (int i = 0; i < BUFLEN; i++)
		buf[i] = (char)0x5A;
	const long result = storage_call(storage_fn, 41, 0, 0, 0);
	for (int i = 0; i < BUFLEN; i++) {
		if (buf[i] != (char)0x5A) {
			decision("synth", 5, 500);
			return;
		}
	}
	decision("synth", 5, result == 42 ? 200 : 501);
}

void start(int, char**) {
	wait_for_requests(on_recv);
}
EOF
bash ${testdir}/build.sh ${tmpdir}/${testname}.cpp ${testdir} ${tmpdir}/${testname}
}

varnish v1 -vcl {
	vcl 4.1;
	import riscv;

	backend default none;

	sub vcl_init {
		riscv.embed_tenants("""{
			"xpizza.com": {
				"filename": "${tmpdir}/${testname}",
				"group": "test"
			},
			"test": {
				"max_instructions": 10000000
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (!riscv.fork(req.http.Host)) {
			return (synth(403));
		}
		riscv.vcall(ON_REQUEST);
		if (riscv.want_result() == "synth") {
			return (synth(riscv.want_status()));
		}
		return (synth(400));
	}
} -start

client c1 {
	txreq -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200

	txreq -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200

	txreq -url "/sp" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
} -run
