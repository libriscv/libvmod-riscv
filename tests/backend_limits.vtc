varnishtest "RISC-V backend functions: the instruction limit, and the status they answer"

shell {
cat >${tmpdir}/${testname}.cpp <<-EOF
#include "riscv_api.hpp"

static void
on_recv(int req) {
	char url[128];
	get_url(req, url, sizeof(url)-1);

	if (strcmp(url, "/loop") == 0) {
		/* A backend function that never returns */
		forge(NOT_CACHED, [] {
			for (;;) asm volatile("");
		});
	} else if (strcmp(url, "/status") == 0) {
		/* Varnish asserts on a status that is not three digits */
		forge(NOT_CACHED, [] {
			static const char mime[] = "text/plain";
			static const char text[] = "Bad status";
			sys_response(42, mime, sizeof(mime)-1, text, sizeof(text)-1);
		});
	} else {
		forge(NOT_CACHED, [] {
			static const char mime[] = "text/plain";
			static const char text[] = "Hello World";
			sys_response(200, mime, sizeof(mime)-1, text, sizeof(text)-1);
		});
	}
}

void start(int argc, char** argv) {
	wait_for_requests(on_recv);
}
EOF
bash ${testdir}/build.sh ${tmpdir}/${testname}.cpp ${testdir} ${tmpdir}/${testname}
}

varnish v1 -vcl+backend {
	vcl 4.1;
	import riscv;

	backend default none;

	sub vcl_init {
		riscv.embed_tenants("""{
			"xpizza.com": {
				"filename": "${tmpdir}/${testname}",
				"group": "test"
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (!riscv.fork(req.http.Host, req.http.X-Debug)) {
			return (synth(403));
		}

		/* Call into VM */
		riscv.vcall(ON_REQUEST);

		if (riscv.want_result() == "backend") {
			set req.http.X-Backend-Func = riscv.result_value(1);
			set req.http.X-Backend-Arg  = riscv.result_value(2);
			if (riscv.result_value(0) == 0) {
				return (pass);
			} else {
				return (hash);
			}
		}

		return (synth(400));
	}

	sub vcl_backend_fetch {
		if (riscv.fork(bereq.http.Host, bereq.http.X-Debug)) {
			riscv.vcall(ON_BACKEND_FETCH);
			if (bereq.http.X-Backend-Func) {
				set bereq.backend = riscv.vm_backend(
						bereq.http.X-Backend-Func,
						bereq.http.X-Backend-Arg);
			}
		}
	}
} -start

# Without a limit, the backend function would keep its thread forever,
# and the fetch would never answer.
client c1 {
	txreq -url "/loop" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 500
	txreq -url "/status" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 500
	txreq -url "/" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
	expect resp.body == "Hello World"
} -run
