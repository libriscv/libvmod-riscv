varnishtest "RISC-V: forks write to untouched master mappings, and CoW copies leave workspace"

shell {
cat >${tmpdir}/${testname}.cpp <<-EOF
#include "riscv_api.hpp"

static inline long syscall6(long n, long a0, long a1, long a2, long a3, long a4, long a5)
{
	register long r0 asm("a0") = a0;
	register long r1 asm("a1") = a1;
	register long r2 asm("a2") = a2;
	register long r3 asm("a3") = a3;
	register long r4 asm("a4") = a4;
	register long r5 asm("a5") = a5;
	register long syscall_id asm("a7") = n;
	asm volatile ("ecall" : "+r"(r0) : "r"(r1), "r"(r2), "r"(r3), "r"(r4), "r"(r5), "r"(syscall_id) : "memory");
	return r0;
}
#define MMAP(addr, len, prot, flags) syscall6(222, addr, len, prot, flags, -1, 0)
#define MPROTECT(addr, len, prot) syscall3(226, addr, len, prot)
#define PROT_RW 3
#define MAP_PRIVATE_ANON 0x22
#define MAP_FIXED 0x10
#define BIG (256 * 1024)

static volatile long* untouched;
static volatile char* big;

static void on_recv(int req)
{
	char url[128];
	const long len = get_url(req, url, sizeof(url)-1);
	url[len < 0 ? 0 : len] = 0;

	if (strcmp(url, "/untouched") == 0) {
		untouched[0] = 42;
		untouched[1024] = 43;
		if (untouched[0] == 42 && untouched[1024] == 43)
			decision("synth", 5, 200);
		else
			decision("synth", 5, 500);
		return;
	}
	if (strcmp(url, "/big") == 0) {
		long sum = 0;
		for (long i = 0; i < BIG; i += 4096) {
			big[i] += 1;
			sum += big[i];
		}
		decision("synth", 5, sum == 2 * (BIG / 4096) ? 200 : 500);
		return;
	}
	decision("synth", 5, 404);
}

void start(int, char**) {
	const long p = MMAP(0, 8192, PROT_RW, MAP_PRIVATE_ANON);
	MMAP(p, 8192, 0, MAP_PRIVATE_ANON | MAP_FIXED);
	MPROTECT(p, 8192, PROT_RW);
	untouched = (volatile long*)p;

	big = (volatile char*)MMAP(0, BIG, PROT_RW, MAP_PRIVATE_ANON);
	for (long i = 0; i < BIG; i += 4096)
		big[i] = 1;

	wait_for_requests(on_recv);
}
EOF
bash ${testdir}/build.sh ${tmpdir}/${testname}.cpp ${testdir} ${tmpdir}/${testname}
}

varnish v1 -arg "-p workspace_client=64k" -vcl {
	vcl 4.1;
	import riscv;

	backend default none;

	sub vcl_init {
		riscv.embed_tenants("""{
			"xpizza.com": {
				"filename": "${tmpdir}/${testname}",
				"group": "test"
			},
			"test": {
				"max_instructions": 1000000,
				"max_memory": 16
			}
		}""");
		riscv.finalize_tenants();
	}

	sub vcl_recv {
		if (!riscv.fork(req.http.Host)) {
			return (synth(403));
		}
		riscv.vcall(ON_REQUEST);
		if (riscv.want_result() == "synth") {
			return (synth(riscv.want_status()));
		}
		return (synth(400));
	}
} -start

client c1 {
	txreq -url "/untouched" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200

	txreq -url "/big" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200

	txreq -url "/big" -hdr "Host: xpizza.com"
	rxresp
	expect resp.status == 200
} -run
