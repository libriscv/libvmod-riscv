// pattern, type, readable phases, writable phases, lowering, write constraint
//
// This file is deliberately data-only. Type checking, phase ownership tests,
// and lowering resolve through VARIABLES; an ABI surface addition has one row.
pub(crate) const FRAMING_HEADERS: &[&str] = &[
    "connection",
    "content-length",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailer",
    "transfer-encoding",
    "upgrade",
];

pub(crate) const VARIABLES: &[VariableSpec] = &[
    VariableSpec {
        pattern: "now",
        value_type: ValueType::Time,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
            Phase::Synth,
        ],
        writable: &[],
        lowering: Lowering::Now,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "client.ip",
        value_type: ValueType::Ip,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
            Phase::Synth,
        ],
        writable: &[],
        lowering: Lowering::ClientIp,
        write_constraint: WriteConstraint::None,
    },
    // Varnish spells the peer address three ways. `remote.ip` is the socket
    // peer and `client.identity` defaults to it; Carapace terminates the
    // client connection itself and has no PROXY-protocol or `X-Forwarded-For`
    // resolution behind these, so all three are the one address the listener
    // accepted. `client.identity` is an IP here rather than Varnish's STRING,
    // which is what "alias" means: it matches an acl and renders as an
    // address in a string context.
    VariableSpec {
        pattern: "remote.ip",
        value_type: ValueType::Ip,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
            Phase::Synth,
        ],
        writable: &[],
        lowering: Lowering::ClientIp,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "client.identity",
        value_type: ValueType::Ip,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
            Phase::Synth,
        ],
        writable: &[],
        lowering: Lowering::ClientIp,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.http.*",
        value_type: ValueType::String,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
        ],
        writable: &[Phase::Recv],
        lowering: Lowering::RequestHeader,
        write_constraint: WriteConstraint::RecvRequestHeader,
    },
    VariableSpec {
        pattern: "bereq.http.*",
        value_type: ValueType::String,
        readable: &[Phase::BackendRequest],
        writable: &[Phase::BackendRequest],
        lowering: Lowering::RequestHeader,
        write_constraint: WriteConstraint::Header,
    },
    VariableSpec {
        pattern: "beresp.http.*",
        value_type: ValueType::String,
        readable: &[Phase::BackendResponse],
        writable: &[Phase::BackendResponse],
        lowering: Lowering::ResponseHeader,
        write_constraint: WriteConstraint::Header,
    },
    VariableSpec {
        pattern: "resp.http.*",
        value_type: ValueType::String,
        readable: &[Phase::Deliver, Phase::Synth],
        writable: &[Phase::Deliver, Phase::Synth],
        lowering: Lowering::ResponseHeader,
        write_constraint: WriteConstraint::Header,
    },
    VariableSpec {
        pattern: "bereq.url",
        value_type: ValueType::String,
        readable: &[Phase::BackendRequest],
        writable: &[Phase::BackendRequest],
        lowering: Lowering::RequestUrl,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.ttl",
        value_type: ValueType::Duration,
        readable: &[Phase::BackendResponse],
        writable: &[Phase::BackendResponse],
        lowering: Lowering::Ttl,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.grace",
        value_type: ValueType::Duration,
        readable: &[Phase::BackendResponse],
        writable: &[Phase::BackendResponse],
        lowering: Lowering::StaleWhileRevalidate,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.keep",
        value_type: ValueType::Duration,
        readable: &[Phase::BackendResponse],
        writable: &[Phase::BackendResponse],
        lowering: Lowering::StaleIfError,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.uncacheable",
        value_type: ValueType::Boolean,
        readable: &[],
        writable: &[Phase::BackendResponse],
        lowering: Lowering::Uncacheable,
        write_constraint: WriteConstraint::TrueOnly,
    },
    // Read-only request/response metadata.
    VariableSpec {
        pattern: "req.url",
        value_type: ValueType::String,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
        ],
        writable: &[],
        lowering: Lowering::RequestUrl,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "req.method",
        value_type: ValueType::String,
        readable: &[
            Phase::Recv,
            Phase::BackendRequest,
            Phase::BackendResponse,
            Phase::Deliver,
        ],
        writable: &[],
        lowering: Lowering::RequestMethod,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "bereq.method",
        value_type: ValueType::String,
        readable: &[Phase::BackendRequest],
        writable: &[],
        lowering: Lowering::RequestMethod,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "beresp.status",
        value_type: ValueType::Integer,
        readable: &[Phase::BackendResponse],
        writable: &[],
        lowering: Lowering::ResponseStatus,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "resp.status",
        value_type: ValueType::Integer,
        readable: &[Phase::Deliver, Phase::Synth],
        writable: &[],
        lowering: Lowering::ResponseStatus,
        write_constraint: WriteConstraint::None,
    },
    // How the delivered response came to be, reduced to the question a hit
    // ratio asks: out of the cache without waiting on the origin (`hit`,
    // `stale`), or not. Deliver-only — no earlier phase knows the answer.
    VariableSpec {
        pattern: "req.cache_hit",
        value_type: ValueType::Boolean,
        readable: &[Phase::Deliver],
        writable: &[],
        lowering: Lowering::CacheHit,
        write_constraint: WriteConstraint::None,
    },
    VariableSpec {
        pattern: "obj.status",
        value_type: ValueType::Integer,
        readable: &[Phase::Deliver],
        writable: &[],
        lowering: Lowering::ResponseStatus,
        write_constraint: WriteConstraint::None,
    },
];
